<!--
  The Dungeon of Fellstone — setup panel
  Paste into: Tabletop Simulator → Scripting → XML tab

  onClick on a Global UI element defaults to the Global Lua script,
  so these names must match the function names in fellstone_setup.lua.
-->

<Panel id="fellstonePanel"
       rectAlignment="UpperRight"
       width="230" height="190"
       offsetXY="-20 -20"
       color="#000000A0">

  <VerticalLayout padding="12 12 12 12" spacing="8">

    <Text fontSize="14" color="#FFFFFF" alignment="MiddleCenter">Fellstone Setup</Text>

    <Button onClick="dealBoard"
            color="#2A2A30"
            textColor="#FFFFFF"
            fontSize="14">Deal Dungeon</Button>

    <Button onClick="clearBoard"
            color="#3A1A1A"
            textColor="#FFFFFF"
            fontSize="14">Clear</Button>

    <Button onClick="buildSnapPoints"
            color="#1A2A3A"
            textColor="#FFFFFF"
            fontSize="14">Build Snap Points</Button>

  </VerticalLayout>
</Panel>
